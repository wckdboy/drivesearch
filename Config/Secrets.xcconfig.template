// Copy to Config/Secrets.xcconfig. That file is gitignored.
// Leave a value empty until you register the OAuth client. No client secrets.

// Google Cloud iOS client. GOOGLE_URL_SCHEME is the reversed client id,
// for example com.googleusercontent.apps.123-abc
GOOGLE_CLIENT_ID=
GOOGLE_URL_SCHEME=drivesearch-google

// Microsoft Entra public client (mobile/desktop), no secret.
MICROSOFT_CLIENT_ID=

// Dropbox app key. Do not put the app secret here.
DROPBOX_APP_KEY=
